# =============================================================================
# RP_ChatBot Environment Configuration
# =============================================================================

# --- Production Domain & Ingress ---
DOMAIN=chat.rpaplaus.com
CADDY_PORT=8085
BACKEND_PORT=8002
FRONTEND_PORT=5185

# --- PostgreSQL Configuration ---
POSTGRES_USER=rp_admin
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=rp_chatbot
POSTGRES_PORT=5438
# Internal connection string for backend container:
DATABASE_URL=postgresql+asyncpg://rp_admin:change-me-postgres-password@database:5432/rp_chatbot

# --- Redis Configuration ---
# Generate with: openssl rand -hex 24
REDIS_PASSWORD=change-me-redis-password
REDIS_PORT=6388
# Internal connection string for backend container:
REDIS_URL=redis://:change-me-redis-password@redis:6379/0

# --- Backend Security ---
# REQUIRED (min 32 chars). Generate with: openssl rand -hex 32
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=1440
SERVICE_TOKEN_EXPIRE_DAYS=90
# REQUIRED (min 32 chars). Generate with: echo "cn_live_$(openssl rand -hex 24)"
CYBERNEXUS_API_KEY=change-me-generate-a-random-api-key

# --- LLM Provider (OpenRouter Unified API) ---
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_URL=https://chat.rpaplaus.com
OPENROUTER_APP_NAME=RP_ChatBot
DEFAULT_OPENROUTER_MODEL=openai/gpt-5

# --- Search Providers ---
TAVILY_API_KEY=your-tavily-api-key-optional
# Google results via serper.dev (used when Tavily is not configured)
SERPER_API_KEY=your-serper-api-key-optional

# --- Legacy Auth (Gradio compatibility during transition) ---
APP_USER=admin
# REQUIRED (min 12 chars). Seeds the admin user on the first migration only;
# to change it later run: python manage_users.py reset-password --username <user> --password <new>
APP_PASSWORD=change-me-strong-password
