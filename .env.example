# =============================================================================
# RP_ChatBot Environment Configuration
# =============================================================================

# --- Production Domain & Ingress ---
DOMAIN=chat.rpaplaus.com
CADDY_PORT=8085
BACKEND_PORT=8002
FRONTEND_PORT=5185

# --- PostgreSQL Configuration ---
POSTGRES_USER=rp_admin
POSTGRES_PASSWORD=rp_secure_postgres_pass
POSTGRES_DB=rp_chatbot
POSTGRES_PORT=5438
# Internal connection string for backend container:
DATABASE_URL=postgresql+asyncpg://rp_admin:rp_secure_postgres_pass@database:5432/rp_chatbot

# --- Redis Configuration ---
REDIS_PASSWORD=rp_secure_redis_pass
REDIS_PORT=6388
# Internal connection string for backend container:
REDIS_URL=redis://:rp_secure_redis_pass@redis:6379/0

# --- Backend Security ---
SECRET_KEY=generate-a-strong-random-secret-key-32-chars-min
ACCESS_TOKEN_EXPIRE_MINUTES=1440
SERVICE_TOKEN_EXPIRE_DAYS=90
CYBERNEXUS_API_KEY=cn_live_rpchatbot_soc_key_2026_x99!

# --- LLM Providers ---
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
GEMINI_API_KEY=your-gemini-api-key
XAI_API_KEY=your-xai-api-key
QWEN_API_KEY=your-qwen-api-key
QWEN_BASE_URL=https://dashscope-us.aliyuncs.com/compatible-mode/v1

# --- Search Providers ---
TAVILY_API_KEY=your-tavily-api-key-optional

# --- Legacy Auth (Gradio compatibility during transition) ---
APP_USER=admin
APP_PASSWORD=your-strong-password
